---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MediaFlow · 极简多平台媒体解析与直链下载",
  description = "高性能、无水印、原画质的多平台公开视频与图集直链解析工具，支持抖音、小红书、哔哩哔哩、快手、微博、TikTok、Instagram等平台。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0b1220');
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(hsl(var(--grid))_1px,transparent_1px)] [background-size:22px_22px] opacity-70 dark:opacity-40"></div>

    <slot />

    <script>
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === '.') {
          e.preventDefault();
          const modal = document.getElementById('admin-modal');
          if (modal) {
            modal.classList.toggle('hidden');
            const input = document.getElementById('admin-secret-input') as HTMLInputElement;
            if (input && !modal.classList.contains('hidden')) {
              input.focus();
            }
          } else {
            window.location.href = '/console';
          }
        }
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
