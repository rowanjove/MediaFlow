---
---

<div id="result-container" class="hidden w-full max-w-3xl mx-auto mt-8">
  <div class="surface rounded-2xl overflow-hidden shadow-float">
    <div class="p-4 sm:p-6 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img id="res-author-avatar" referrerpolicy="no-referrer" class="w-10 h-10 rounded-full border border-border object-cover bg-muted" src="" alt="" />
        <div>
          <div class="flex items-center gap-2">
            <span id="res-author-name" class="font-semibold text-sm text-foreground"></span>
            <span id="res-platform-tag" class="chip uppercase"></span>
          </div>
          <div class="text-[11px] text-muted-foreground mt-0.5">
            <span id="res-created-at"></span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="copy-json-btn" class="btn-secondary font-mono" title="复制原始 JSON 数据" data-i18n="result.copy_json">JSON</button>
        <button id="open-source-btn" class="btn-secondary" title="在新标签页中访问原帖">
          <span data-i18n="result.source">原链接</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </button>
      </div>
    </div>

    <div class="p-4 sm:p-6 pb-2">
      <h2 id="res-title" class="text-base sm:text-lg font-medium text-foreground leading-snug break-words"></h2>
    </div>

    <div class="p-4 sm:p-6 pt-2 space-y-6">
      <div id="video-section" class="hidden space-y-4">
        <div class="relative rounded-xl overflow-hidden bg-black aspect-video border border-border">
          <video id="res-video-player" referrerpolicy="no-referrer" controls playsinline preload="metadata" class="w-full h-full object-contain"></video>
        </div>
        <div id="video-actions" class="flex flex-wrap items-center gap-2.5"></div>
      </div>

      <div id="images-section" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <div class="text-xs text-muted-foreground font-mono">
            <span data-i18n="result.images_prefix">共 </span><span id="images-count" class="text-foreground font-semibold">0</span><span data-i18n="result.images_suffix"> 张高清图片</span>
          </div>
          <button id="download-all-images-btn" class="btn-secondary" data-i18n="result.open_all">
            批量打开原图
          </button>
        </div>
        <div id="images-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"></div>
      </div>

      <div id="audio-section" class="hidden p-3.5 rounded-xl surface flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5 text-xs text-foreground">
          <div class="w-8 h-8 rounded-lg bg-accent text-accent-foreground flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <div>
            <div class="font-medium" data-i18n="result.audio_title">背景音乐 / 原声音频</div>
            <div class="text-[11px] text-muted-foreground font-mono" data-i18n="result.audio_desc">独立音频直链</div>
          </div>
        </div>
        <a id="audio-download-link" href="#" target="_blank" download class="btn-primary" data-i18n="result.audio_download">下载音频</a>
      </div>
    </div>
  </div>
</div>
