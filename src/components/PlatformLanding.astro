---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import ParseApp from './ParseApp.astro';
import AdminModal from './AdminModal.astro';

interface Props {
  platform: string;
  name: string;
  description: string;
  types: string[];
  notes: string;
}

const { platform, name, description, types, notes } = Astro.props;
const title = `${name} 解析下载 · MediaFlow`;
---

<Layout title={title} description={description}>
  <Header />
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="max-w-xl mx-auto text-center mb-8">
      <a href="/" class="text-[11px] font-mono text-muted-foreground hover:text-primary">← 返回首页</a>
      <h1 class="mt-3 text-2xl sm:text-4xl font-bold tracking-tight text-foreground">{name} 公开内容解析</h1>
      <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{description}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-1.5">
        {types.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    </div>

    <ParseApp />

    <p class="max-w-xl mx-auto mt-8 text-xs text-muted-foreground leading-relaxed text-center">{notes}</p>
    <p class="sr-only">platform:{platform}</p>
  </main>
  <AdminModal />
</Layout>
