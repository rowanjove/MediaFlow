{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@worker/*": ["worker/*"]
    },
    "types": ["@cloudflare/workers-types", "astro/client", "vite/client"]
  },
  "include": ["src/**/*", "worker/**/*", "tests/**/*"]
}