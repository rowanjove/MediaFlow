{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-flow",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "vars": {
    "APP_NAME": "MediaFlow",
    "COBALT_PRIMARY_URL": "",
    "RATE_LIMIT_COUNT": "60",
    "RATE_LIMIT_WINDOW": "60"
  }
}
